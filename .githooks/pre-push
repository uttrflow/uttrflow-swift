#!/usr/bin/env bash
#
# The gate, run locally, before CI runs it again.
#
# This began as a replacement for CI: macOS runners bill at ten times the Linux rate, this
# project cannot use Linux, and fifty-one runs over two days ate 97% of a month's minutes —
# after which jobs stopped starting silently, for days, while the repository went on looking
# green. So the check moved to the machine that was going to run it anyway.
#
# A public repository does not pay for standard runners, so CI is back and this is no longer
# the last line of defence. It is kept because it is still the fastest one. Below is
# what .github/workflows/ci.yml did: `make verify`, which is lint, a full build, 4,000+
# tests and the coverage floor.
#
# This is no longer the only gate. CI runs `make verify` on every pull request, and a
# ruleset blocks pushing to `main` at the server. What the hook is now is the fast one: it
# answers in the time a build takes rather than a queue plus a build, and it answers before
# a reviewer is looking.
#
# It gates pushes to `main`, which in practice only the operator can make. A feature branch
# is somebody's work in progress and blocking it would teach people to reach for
# --no-verify, which turns the gate off for the trunk too.
#
# To skip it deliberately:  git push --no-verify
# Install it:               make hooks   (sets core.hooksPath; hooks are not cloned)
set -uo pipefail

REMOTE_NAME="${1:-origin}"

# Git describes each ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# An all-zero local sha is a deletion, which builds nothing and is let through.
ZERO="0000000000000000000000000000000000000000"
gate=no
pushed=()
while read -r _local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$ZERO" ]] && continue
    # A new branch has no remote counterpart, so ask what the remote does not have yet
    # rather than replaying the whole history of the project on every first push.
    if [[ "$remote_sha" == "$ZERO" ]]; then
        pushed+=("$local_sha --not --remotes=$REMOTE_NAME")
    else
        pushed+=("$remote_sha..$local_sha")
    fi
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        gate=yes
        gate_sha="$local_sha"
    fi
done

# ---------------------------------------------------------------------------
# The disclosure gate runs on every ref, and it runs first
# ---------------------------------------------------------------------------
# `make verify` gates `main` alone because it costs five minutes, and blocking a feature
# branch for that long teaches people to reach for --no-verify. This check costs two
# seconds, so it can afford what the rule actually asks for: nothing private to building
# this product lands in *any* remote branch. On a public repository a feature branch is
# published and indexed the moment it is pushed — main is not the boundary, the remote is.
#
# It reads the commits being pushed, not the working tree: messages and the added side of
# every diff, which is where this class of mistake lives and where no file audit looks.
# A branch cut before this script existed does not carry it, and blocking that push would
# be the hook failing rather than the branch. The commit-msg hook guards the same way.
if ((${#pushed[@]})) && [[ -f Scripts/disclosure_audit.py ]]; then
    printf '\n\033[1mpre-push: checking what is about to be published\033[0m\n'
    for range in "${pushed[@]}"; do
        # Deliberately unquoted: a new-branch range is three arguments, not one.
        # shellcheck disable=SC2086
        if ! python3 Scripts/disclosure_audit.py --range $range; then
            printf '\n\033[31m  nothing was pushed\033[0m\n'
            printf '  A commit message or an added line carries text that must not be\n'
            printf '  published. See AGENTS.md, "What must never reach a tracked file".\n'
            printf '  Amend or rewrite the commit — the branch has not left this machine,\n'
            printf '  so this is still fixable. After a push it is not.\n\n'
            exit 1
        fi
    done
fi

if [[ "$gate" != "yes" ]]; then
    exit 0
fi

printf '\n\033[1mpre-push: verifying before a trunk\033[0m  (%s)\n' "$REMOTE_NAME"

# ---------------------------------------------------------------------------
# Verify the commit, not the desk it was written on
# ---------------------------------------------------------------------------
# The obvious hook runs `make verify` right here, and it is wrong twice over.
#
# It checks the working tree, but what is being pushed is a commit. Those differ whenever
# anything is uncommitted — which in this repository is nearly always, because more than
# one agent works in it at a time. The first push after this hook existed was blocked by a
# lint error in a file its commit did not touch, belonging to a session that was still
# typing. A gate that fails for reasons unrelated to what you are pushing is a gate people
# learn to bypass, and then it is not a gate.
#
# It also races those agents for `.build`, which they share and corrupt.
#
# So the check happens in a worktree of its own, checked out to exactly the commit being
# pushed. The worktree is reused rather than created each time, so its `.build` stays warm
# and a verify costs the same as it did before; it lives inside .git, so nothing about the
# working tree changes and nothing can appear in `git status`.
# `--git-common-dir`, not `<toplevel>/.git`. In a worktree that path is a *file* — a
# pointer to the real repository — so every mkdir and `git worktree add` under it fails
# with "Not a directory". Pushes normally come from the main checkout, where the two are
# the same thing, which is why this went unnoticed; but the rulebook now has everyone
# working in worktrees, and a push from one would have hit it.
git_dir="$(git rev-parse --git-common-dir)"
[[ "$git_dir" == /* ]] || git_dir="$(git rev-parse --show-toplevel)/$git_dir"
verify_tree="$git_dir/verify-worktree"

# The last ref bound for main is what gets checked. Pushing several at once is not a thing
# that happens here, and verifying the tip is the answer that matters.
if [[ -z "${gate_sha:-}" ]]; then
    printf '\033[31mnothing to verify: no commit was resolved for main\033[0m\n'
    exit 1
fi

# ---------------------------------------------------------------------------
# One verify at a time
# ---------------------------------------------------------------------------
# The worktree is shared and reused — that is what keeps its `.build` warm and a verify
# as cheap as it was before. Shared means two pushes can want it at once, and more than
# one agent works in this repository at a time, so that is not hypothetical: it happened.
# The second push checked its own commit out from under the first, which was midway
# through a build. The first then compiled a mixture of two trees, reported failures in
# files its commit had never touched, and refused a push that was fine.
#
# `mkdir` is the atomic primitive here. `flock` is not on macOS, and `[[ -d ]]` followed
# by `mkdir` is a race in the same shape as the one being fixed.
lock="$git_dir/verify-worktree.lock"
waited=0
until mkdir "$lock" 2>/dev/null; do
    holder="$(cat "$lock/pid" 2>/dev/null || true)"
    # A lock whose holder is gone is debris from a kill or a crash, not a live push.
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
        printf '  clearing a lock left behind by pid %s\n' "$holder"
        rm -rf "$lock"
        continue
    fi
    if (( waited == 0 )); then
        printf '  another push is verifying (pid %s) — waiting for it\n' "${holder:-unknown}"
    fi
    if (( waited >= 1800 )); then
        printf '\033[31mgave up waiting after 30 minutes\033[0m\n'
        printf '  If nothing is really running:  rm -rf %s\n' "$lock"
        exit 1
    fi
    sleep 5
    waited=$((waited + 5))
done
printf '%s' "$$" > "$lock/pid"
# Released however this exits — including the failure paths below, each of which used to
# be a way to leave the gate locked against every later push.
trap 'rm -rf "$lock"' EXIT

if [[ ! -d "$verify_tree" ]]; then
    printf '  first run: preparing an isolated worktree (the build after this one is warm)\n'
    git worktree add --detach --quiet "$verify_tree" "$gate_sha" || {
        printf '\033[31mcould not create the verify worktree\033[0m\n'
        exit 1
    }
else
    # --force because a previous run left build products in it; they are exactly what we
    # want to keep, and they are all ignored files so nothing tracked is discarded.
    git -C "$verify_tree" checkout --detach --quiet --force "$gate_sha" || {
        printf '\033[31mcould not check %s out into the verify worktree\033[0m\n' "${gate_sha:0:8}"
        printf '  Remove it and let the next push rebuild it:  git worktree remove --force %s\n' "$verify_tree"
        exit 1
    }
fi

printf '  commit %s, in a clean checkout\n' "${gate_sha:0:8}"

# Every swift invocation needs this, in every shell — a hook does not inherit the one from
# an interactive profile.
export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
if [[ ! -d "$DEVELOPER_DIR" ]]; then
    printf '\033[31mno Xcode at %s\033[0m\n' "$DEVELOPER_DIR"
    printf '  The full Xcode is required; the Command Line Tools alone will not do.\n'
    exit 1
fi

started="$SECONDS"
log="$(mktemp -t uttrflow-prepush)"

# Piped to a file rather than shown: `make verify` prints thousands of passing test names,
# and burying the one failure under them is how a gate stops being read. The tail is shown
# only when it matters.
if make -C "$verify_tree" verify > "$log" 2>&1; then
    printf '\033[32m  verify passed\033[0m in %ds — pushing\n\n' "$((SECONDS - started))"
    rm -f "$log"
    exit 0
fi

printf '\n\033[31m  verify FAILED\033[0m after %ds — nothing was pushed\n\n' "$((SECONDS - started))"

# Lint failures and test failures read completely differently, and the useful lines are in
# different places, so pull whichever kind actually occurred rather than printing a fixed
# window and hoping.
if grep -qE '^\S+\.swift:[0-9]+:[0-9]+: error:' "$log"; then
    printf '  Lint:\n'
    grep -E '^\S+\.swift:[0-9]+:[0-9]+: error:' "$log" | head -15 | sed 's/^/    /'
elif grep -q '✘' "$log"; then
    printf '  Tests:\n'
    grep -E '✘ Test .*recorded an issue' "$log" | head -10 | sed 's/^/    /'
else
    tail -25 "$log" | sed 's/^/    /'
fi

printf '\n  Full log: %s\n' "$log"
printf '  Re-run by hand with: make verify\n\n'
exit 1
