.build/
.swiftpm/
DerivedData/
*.xcuserdatad
xcuserdata/
.DS_Store

# Built application bundle and its intermediates.
/dist/

# Downloaded speech and language models. Large, reproducible, never committed.
/Models/

# Seeded design canvas — regenerated from Design/*.dc.html by the seed helper.
Design/uttrflow-interface.html

# Scratch render written by Design/_preview_gen.py.
Design/_preview.html

# Bake-off results, regenerated by `make bakeoff`.
/.bakeoff/

# Coverage artefact dropped by instrumented binaries when run outside the harness.
default.profraw

# Scratch git worktrees used by parallel agents; never part of the project.
.claude/worktrees/

# Python bytecode from the design generators.
Design/__pycache__/

# Sign-in provider marks. Third-party trademarks, fetched from each provider's own
# published pack by Scripts/fetch-provider-marks.sh rather than redistributed here.
# The app builds and runs without them; the buttons carry their wording alone.
/Sources/Uttrflow/Resources/GoogleMark.png
/Sources/Uttrflow/Resources/ProviderMarks/
